{
  "name": "pepo-monorepo",
  "version": "1.2.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "rider": "npm run start -w @pepo/rider",
    "driver": "npm run start -w @pepo/driver",
    "api": "npm run start -w @pepo/api",
    "server": "npm run api",
    "web:rider": "npm run web -w @pepo/rider",
    "web:driver": "npm run web -w @pepo/driver",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "lint": "node scripts/assert-boundaries.cjs && eslint apps packages tests scripts",
    "check": "npm run typecheck && npm run lint && npm test",
    "build:api": "node scripts/build-api.cjs",
    "export:rider": "npm run export:ios -w @pepo/rider",
    "export:driver": "npm run export:ios -w @pepo/driver",
    "smoke:web": "node --import tsx scripts/smoke-ui.cjs",
    "start": "npm run rider",
    "maps:doctor": "npm run maps:doctor -w @pepo/rider"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/google.maps": "^3.66.4",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^6.0.0",
    "playwright": "1.56.1",
    "prettier": "3.6.2",
    "supertest": "^7.1.0",
    "tsx": "^4.20.0",
    "typescript": "~6.0.3",
    "vitest": "^3.2.0",
    "@types/react": "~19.2.4",
    "esbuild": "^0.27.4",
    "eslint": "^9.39.4",
    "typescript-eslint": "^8.57.1"
  }
}
