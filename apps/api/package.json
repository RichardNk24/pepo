{
  "name": "@pepo/api",
  "version": "1.2.0",
  "private": true,
  "scripts": {
    "start": "node --import tsx --env-file-if-exists=.env src/index.ts",
    "dev": "node --watch --import tsx --env-file-if-exists=.env src/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "node ../../scripts/build-api.cjs",
    "production": "node --env-file-if-exists=.env dist/index.cjs"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^17.0.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.0",
    "helmet": "^8.1.0",
    "multer": "^2.0.2",
    "socket.io": "^4.8.1",
    "zod": "^4.0.0",
    "@pepo/types": "1.2.0",
    "@pepo/utils": "1.2.0",
    "@pepo/maps": "1.2.0",
    "@pepo/i18n": "1.2.0",
    "@pepo/voice": "1.2.0"
  }
}
