# API commune — jamais de secrets dans les applications mobiles.
PORT=4000
NODE_ENV=development
DATA_DIR=data
PUBLIC_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081,http://localhost:8082,http://127.0.0.1:8082
# Seulement en développement local : code OTP renvoyé sans SMS.
DEV_AUTH=true
ADMIN_TOKEN=
STORAGE_KEY=
GOOGLE_MAPS_SERVER_KEY=
GOOGLE_MAPS_WEB_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Recherche automatique : clé uniquement dans le backend. Activation serveur.
OPENAI_API_KEY=
PEPO_AI_PLACES_ENABLED=false
OPENAI_PLACES_MODEL=gpt-4.1-mini
PEPO_AI_DAILY_CALL_LIMIT=100
# Chemin absolu recommandé vers votre catalogue Pepo avec coordonnées vérifiées.
PEPO_LANDMARKS_FILE=

# Dictée dans Expo Go : OpenAI côté serveur, sans sauvegarde audio serveur.
# Si absent, PEPO_VOICE_ENABLED suit PEPO_AI_PLACES_ENABLED.
PEPO_VOICE_ENABLED=true
OPENAI_TRANSCRIPTION_MODEL=gpt-transcribe
PEPO_VOICE_DAILY_CALL_LIMIT=20
